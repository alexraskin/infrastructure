# Copy to secrets/oci.env at the repo root (secrets/ is gitignored) and fill in.
# The mise tasks source this file, so the values reach Terraform as TF_VAR_* and
# never touch a tfvars file, a plan output, or a diff.
#
# Where each comes from in the OCI console:
#   tenancy/user OCID, fingerprint -> Profile -> User settings -> API keys.
#                                     "Add API key" prints a config snippet
#                                     containing all three.
#   private key                    -> downloaded when that key is created
#   compartment                    -> Identity -> Compartments (the tenancy
#                                     OCID is the root compartment and works)
#   region                         -> nearest to home; every byte crosses it

export TF_VAR_oci_tenancy_ocid="ocid1.tenancy.oc1..aaaa..."
export TF_VAR_oci_user_ocid="ocid1.user.oc1..aaaa..."
export TF_VAR_oci_fingerprint="aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
export TF_VAR_oci_region="us-phoenix-1"
export TF_VAR_oci_compartment_ocid="ocid1.compartment.oc1..aaaa..."

# Object Storage namespace. Every Terraform root in this repo keeps its state in
# a bucket there, so this is read by `terraform init`, by 00-global/ itself, and
# by the roots that read another root's state. Console -> Tenancy details ->
# Object Storage namespace, or `oci os ns get`.
export TF_VAR_oci_namespace="axaaaaaaaaaa"

# Primary email for the terraform-ci IAM user 00-global/ creates. An Identity
# Domains tenancy rejects a user without one. Your own address is fine.
export TF_VAR_ci_user_email="you@example.com"

# Must match nixos/hosts/edge-1/ssh-keys.nix.
export TF_VAR_ssh_public_key="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL9eDKXtB1s6U9XCukV9AdQzAsSxCdX3BpALWsaMOhm+ alex@morpheus"

# The signing key defaults to secrets/oci_api_key.pem. Set this only if it is
# named something else. (secrets/oci_api_key_public.pem is the half already
# uploaded to OCI; nothing here reads it.)
# export TF_VAR_oci_private_key_path="/home/alex/coding/infrastructure/secrets/oci_api_key.pem"

# Optional: narrow SSH once the tailnet is up.
# export TF_VAR_ssh_ingress_cidr="203.0.113.4/32"
#
# TF_VAR_cloudflare_api_token is NOT set here — the mise tasks read it from
# secrets/cloudflare-api-token, the same file terraform/cloudflare/ uses.
