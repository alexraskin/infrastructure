# Copy to secrets.sops.yaml, fill in, then: sops --encrypt --in-place secrets.sops.yaml
#
# What CI is allowed to see. The OCI credentials here are the terraform-ci
# user's — `mise run global:ci-creds` prints them — so a leak reaches the state
# bucket and nothing else in the tenancy.

backend_tenancy_ocid: ocid1.tenancy.oc1..aaaa...
backend_user_ocid: ocid1.user.oc1..aaaa...
backend_fingerprint: aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
backend_region: us-phoenix-1
backend_namespace: axaaaaaaaaaa
backend_private_key: |
  -----BEGIN RSA PRIVATE KEY-----
  ...
  -----END RSA PRIVATE KEY-----

# Zone/DNS/Edit + Zone/Zone/Read. The cloudflare provider reads this from the
# environment, so tf.sh exports it rather than the root declaring a variable.
cloudflare_api_token: ...

# Only used locally: CI authenticates to Tailscale with OIDC federation instead.
tailscale_oauth_client_id: ...
tailscale_oauth_client_secret: ...
