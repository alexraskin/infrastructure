# Discord notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME

# NAS configuration (Tailscale IP of your Synology)
NAS_IP=

# Plex container
PLEX_CONTAINER=plex
PLEX_DATA_PATH=/var/lib/plexmediaserver
BACKUP_DIR=/mnt/plex_backup
BACKUP_KEEP=5

PLEX_SERVER=http://localhost:32400
PLEX_TOKEN=CHANGE_ME
