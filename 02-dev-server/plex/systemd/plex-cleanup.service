[Unit]
Description=Plex Backup Cleanup Service
After=mnt-plex_backup.mount
Requires=mnt-plex_backup.mount

[Service]
Type=oneshot
EnvironmentFile=__REPO_DIR__/.env
ExecStart=__REPO_DIR__/bin/cleanup_plex_backups.sh
User=root
StandardOutput=append:/mnt/plex_backup/cleanup.log
StandardError=append:/mnt/plex_backup/cleanup.log

[Install]
WantedBy=multi-user.target
