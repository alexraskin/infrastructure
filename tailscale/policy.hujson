{
	"acls": [],

	"ssh": [
		{
			"action":      "check",
			"src":         ["autogroup:member"],
			"dst":         ["autogroup:self"],
			"users":       ["autogroup:nonroot", "root"],
			"checkPeriod": "92h",
		},

		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["tag:cloud-edge"],
			"users":  ["root"],
		},

		// The deploy workflow. `accept`, not `check`: a check wants a human at a
		// browser and would hang the runner until the job times out.
		{
			"action": "accept",
			"src":    ["tag:ci"],
			"dst":    ["tag:cloud-edge"],
			"users":  ["root"],
		},
	],

	"nodeAttrs": [
		{
			"target": ["100.85.169.74"],
			"attr":   ["mullvad"],
		}, // iphone
		{
			"target": ["100.69.120.5"],
			"attr":   ["mullvad"],
		}, // ipad
		{
			"target": ["100.106.228.80"],
			"attr":   ["mullvad"],
		}, // apple tv
		{
			"target": ["100.121.60.28"],
			"attr":   ["mullvad"],
		}, // gaming-pc
		{
			"target": ["100.100.15.74"],
			"attr":   ["mullvad"],
		}, // macbook air
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
		{
			"target": ["autogroup:member"],
			"attr":   ["drive:share", "drive:access"],
		},
	],

	"grants": [
		{
			"src": ["autogroup:admin"],
			"dst": ["*"],
			"ip":  ["*"],
		},

		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},

		// (01-cloud-edge). It is the only device on this tailnet with a public IP
		{
			"src": ["tag:cloud-edge"],
			"dst": ["100.73.219.120"],
			"ip":  ["tcp:32400"],
		},

		// Log push. Loki has no auth; this grant is the access control.
		{
			"src": ["tag:cloud-edge"],
			"dst": ["tag:k8s-loki"],
			"ip":  ["tcp:3100"],
		},

		// Gatus probes. The src is tag:k8s — the operator's proxies — because the
		// Talos nodes are not on the tailnet at all: each probe leaves through an
		// egress proxy declared in apps/base/gatus/egress.yaml.
		{
			"src": ["tag:k8s"],
			"dst": ["tag:cloud-edge"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["tag:k8s"],
			"dst": ["100.109.167.97"],
			"ip":  ["tcp:443"],
		},

		// The deploy workflow reaches the edge over SSH, and nothing else.
		{
			"src": ["tag:ci"],
			"dst": ["tag:cloud-edge"],
			"ip":  ["tcp:22"],
		},
	],

	"tagOwners": {

		"tag:k8s-operator": [],
		"tag:k8s":          ["tag:k8s-operator"],


		"tag:k8s-loki": ["tag:k8s-operator"],

		// The in-cluster subnet router (apps/base/tailscale-router/). Split out
		// from tag:k8s so only it can advertise the LAN route.
		"tag:k8s-router": ["tag:k8s-operator"],

		"tag:cloud-edge": [],

		// GitHub Actions, joining ephemerally with a tailnet-lock-signed auth key.
		"tag:ci": [],
	},

	"autoApprovers": {
		"routes": {
			"${cluster_subnet}": ["tag:k8s-router"],
		},

		// Without this the edge advertises 0.0.0.0/0 and waits for a human.
		"exitNode": ["tag:cloud-edge"],
	},

	// Evaluated by the API at `terraform plan`, so a widened grant fails the PR.
	"tests": [
		{
			// The edge reaches its one backend and Loki, nothing else.
			"src":   "tag:cloud-edge",
			"proto": "tcp",
			"accept": [
				"100.73.219.120:32400",
				"tag:k8s-loki:3100",
			],
			"deny": [
				"100.73.219.120:22",
				"${cluster_vip}:6443",
				"${node["talos-cp-1"]}:22",
				// tag:k8s-loki is split out so this stays denied.
				"tag:k8s:443",
			],
		},
		{
			// The operator's proxies, which now carry the gatus probes too.
			// Only what gatus probes, nothing else.
			"src":    "tag:k8s",
			"proto":  "tcp",
			"accept": ["tag:cloud-edge:443", "100.109.167.97:443"],
			"deny": [
				"100.73.219.120:32400",
				"${cluster_vip}:6443",
				"tag:cloud-edge:22",
				"100.109.167.97:5001",
			],
		},
		{
			// The subnet router advertises the route; it does not get to use it.
			"src":   "tag:k8s-router",
			"proto": "tcp",
			"deny":  ["100.73.219.120:32400", "tag:cloud-edge:22"],
		},
		{
			// CI reaches the edge over SSH and nothing else on this tailnet.
			"src":    "tag:ci",
			"proto":  "tcp",
			"accept": ["tag:cloud-edge:22"],
			"deny": [
				"100.73.219.120:32400",
				"${cluster_vip}:6443",
				"tag:k8s-loki:3100",
				"tag:cloud-edge:443",
			],
		},
	],

	// autogroup:self is user-owned devices only; a tagged node has no owner.
	"sshTests": [
		{
			"src":  "tag:cloud-edge",
			"dst":  ["tag:k8s"],
			"deny": ["root", "autogroup:nonroot"],
		},
		{
			"src":    "tag:ci",
			"dst":    ["tag:cloud-edge"],
			"accept": ["root"],
		},
	],
}
