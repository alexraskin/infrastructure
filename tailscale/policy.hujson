{
	"acls": [],

	"ssh": [
		{
			"action":      "check",
			"src":         ["autogroup:member"],
			"dst":         ["autogroup:self"],
			"users":       ["autogroup:nonroot", "root"],
			"checkPeriod": "92h",
		},

		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["tag:cloud-edge"],
			"users":  ["root"],
		},
	],

	"nodeAttrs": [
		{
			"target": ["100.85.169.74"],
			"attr":   ["mullvad"],
		}, // iphone
		{
			"target": ["100.69.120.5"],
			"attr":   ["mullvad"],
		}, // ipad
		{
			"target": ["100.106.228.80"],
			"attr":   ["mullvad"],
		}, // apple tv
		{
			"target": ["100.121.60.28"],
			"attr":   ["mullvad"],
		}, // gaming-pc
		{
			"target": ["100.100.15.74"],
			"attr":   ["mullvad"],
		}, // macbook air
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
		{
			"target": ["autogroup:member"],
			"attr":   ["drive:share", "drive:access"],
		},
	],

	"grants": [
		{
			"src": ["autogroup:admin"],
			"dst": ["*"],
			"ip":  ["*"],
		},

		// Exit node. `dst: ["*"]` above does not cover this — autogroup:internet
		// is only matched when it is named, so without this grant the edge is
		// approved as an exit node and every client using it gets nothing.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},

		// (00-cloud-edge). It is the only device on this tailnet with a public IP
		{
			"src": ["tag:cloud-edge"],
			"dst": ["100.73.219.120"],
			"ip":  ["tcp:32400"],
		},

		// Log push. Loki has no auth; this grant is the access control.
		{
			"src": ["tag:cloud-edge"],
			"dst": ["tag:k8s-loki"],
			"ip":  ["tcp:3100"],
		},

		// Gatus probes. tag:k3s is the src because pod egress leaves through a
		// node and is SNAT'd to its tailnet address.
		{
			"src": ["tag:k3s"],
			"dst": ["tag:cloud-edge"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["tag:k3s"],
			"dst": ["100.109.167.97"], // chronos, the NAS
			"ip":  ["tcp:443"],
		},
	],

	"tagOwners": {

		"tag:k8s-operator": [],
		"tag:k8s":          ["tag:k8s-operator"],


		"tag:k8s-loki": ["tag:k8s-operator"],

		"tag:k3s": [],

		"tag:cloud-edge": [],
	},

	"autoApprovers": {
		"routes": {
			"10.0.200.0/24": ["tag:k3s"],
		},

		// Without this the edge advertises 0.0.0.0/0 and waits for a human.
		"exitNode": ["tag:cloud-edge"],
	},

	// Evaluated by the API at `terraform plan`, so a widened grant fails the PR.
	"tests": [
		{
			// The edge reaches its one backend and Loki, nothing else.
			"src":   "tag:cloud-edge",
			"proto": "tcp",
			"accept": [
				"100.73.219.120:32400",
				"tag:k8s-loki:3100",
			],
			"deny": [
				"100.73.219.120:22",
				"10.0.200.40:6443",
				"10.0.200.41:22",
				// tag:k8s-loki is split out so this stays denied.
				"tag:k8s:443",
			],
		},
		{
			// Subnet routers. Only what gatus probes, nothing else.
			"src":    "tag:k3s",
			"proto":  "tcp",
			"accept": ["tag:cloud-edge:443", "100.109.167.97:443"],
			"deny": [
				"100.73.219.120:32400",
				"10.0.200.40:6443",
				"tag:cloud-edge:22",
				"100.109.167.97:5001",
			],
		},
		{
			// Same for the operator's proxies.
			"src":   "tag:k8s",
			"proto": "tcp",
			"deny":  ["100.73.219.120:32400", "10.0.200.40:6443"],
		},
	],

	// autogroup:self is user-owned devices only; a tagged node has no owner.
	"sshTests": [
		{
			"src":  "tag:cloud-edge",
			"dst":  ["tag:k3s"],
			"deny": ["root", "autogroup:nonroot"],
		},
	],
}
