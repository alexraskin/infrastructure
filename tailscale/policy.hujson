{
	"acls": [],

	"ssh": [
		{
			"action":      "check",
			"src":         ["autogroup:member"],
			"dst":         ["autogroup:self"],
			"users":       ["autogroup:nonroot", "root"],
			"checkPeriod": "92h",
		},
	],

	"nodeAttrs": [
		{
			"target": ["100.85.169.74"],
			"attr":   ["mullvad"],
		}, // iphone
		{
			"target": ["100.69.120.5"],
			"attr":   ["mullvad"],
		}, // ipad
		{
			"target": ["100.106.228.80"],
			"attr":   ["mullvad"],
		}, // apple tv
		{
			"target": ["100.121.60.28"],
			"attr":   ["mullvad"],
		}, // gaming-pc
		{
			"target": ["100.100.15.74"],
			"attr":   ["mullvad"],
		}, // macbook air
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
		{
			"target": ["autogroup:member"],
			"attr":   ["drive:share", "drive:access"],
		},
	],

	"grants": [
		{
			"src": ["autogroup:admin"],
			"dst": ["*"],
			"ip":  ["*"],
		},

		// (00-edge-compute). It is the only device on this tailnet with a public IP
		{
			"src": ["tag:edge"],
			"dst": ["100.73.219.120"],
			"ip":  ["tcp:32400"],
		},
	],

	"tagOwners": {

		"tag:k8s-operator": [],
		"tag:k8s":          ["tag:k8s-operator"],

		"tag:k3s": [],

		"tag:edge": [],
	},

	"autoApprovers": {
		"routes": {
			"10.0.200.0/24": ["tag:k3s"],
		},
	},

	// Evaluated by the API during `terraform plan`, so a grant that widens
	// access fails the pull request rather than the apply.
	"tests": [
		{
			// The edge node is the only device here reachable from the public
			// internet. Both halves of its containment are asserted: the one
			// backend it reverse-proxies, and the reach it must not have —
			// other ports on the same host, the cluster VIP, a k3s node.
			"src":    "tag:edge",
			"proto":  "tcp",
			"accept": ["100.73.219.120:32400"],
			"deny": [
				"100.73.219.120:22",
				"10.0.200.40:6443",
				"10.0.200.41:22",
			],
		},
		{
			// The k3s nodes advertise 10.0.200.0/24 but are named as a src
			// nowhere in grants, so being a subnet router buys them no access
			// of their own.
			"src":   "tag:k3s",
			"proto": "tcp",
			"deny":  ["100.73.219.120:32400", "10.0.200.40:6443"],
		},
		{
			// Same for the per-Ingress proxies the operator creates.
			"src":   "tag:k8s",
			"proto": "tcp",
			"deny":  ["100.73.219.120:32400", "10.0.200.40:6443"],
		},
	],

	// autogroup:self covers user-owned devices only, so a tagged node — which
	// has no user — gets no SSH anywhere.
	"sshTests": [
		{
			"src":  "tag:edge",
			"dst":  ["tag:k3s"],
			"deny": ["root", "autogroup:nonroot"],
		},
	],
}
