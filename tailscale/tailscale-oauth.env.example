# Copy to secrets/tailscale-oauth.env (gitignored). Only needed for `mise run
# ts:plan` / `ts:apply` by hand; CI uses a federated identity. Admin console ->
# Settings -> OAuth clients, scope policy_file:write. See CLAUDE.md — this is
# not any of the other Tailscale credentials in the repo.

TAILSCALE_OAUTH_CLIENT_ID=<client id>
TAILSCALE_OAUTH_CLIENT_SECRET=<client secret, shown once>
