# Copy to secrets/tailscale-oauth.env (gitignored) and fill in. Only needed to
# run `mise run ts:plan` / `ts:apply` by hand — CI authenticates as a federated
# identity instead and never sees a secret.
#
# Tailscale admin console -> Settings -> OAuth clients -> Generate. The client
# needs exactly one scope: policy_file, write. Nothing else touches the policy
# file, and this credential can rewrite the whole tailnet's access rules.
#
# Unrelated to every other Tailscale credential in this repo:
#   secrets/tailscale-authkey        pre-auth key, tag:k3s, for the six VMs
#   secrets/tailscale-authkey-edge   pre-auth key, tag:edge, for the Oracle box
#   apps/base/tailscale-operator/oauth.sops.yaml
#                                    OAuth client, tag:k8s-operator, for the
#                                    operator's per-Ingress proxies
# None of them works in place of another.

TAILSCALE_OAUTH_CLIENT_ID=<client id>
TAILSCALE_OAUTH_CLIENT_SECRET=<client secret, shown once>
